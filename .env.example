# Optional local overrides. Copy to .env; never use mock auth on a shared listener.
WATCH_DESK_PORT=8080
OPENSEARCH_PORT=9200
ARK_MOCK_AUTH=1
ARK_MOCK_AUTH_AS=user

# Optional existing custody volume when adopting a standalone worker.
# Stop the old worker first; never share a writable journal between processes.
# PARSE_COMMAND_CUSTODY_VOLUME=parse-command-intake_custody

# Only when importing a frozen prior Go database from watch-desk-data.
# Leave empty for a fresh installation.
PARSE_COMMAND_LEGACY_DB=
