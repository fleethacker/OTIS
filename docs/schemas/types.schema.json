          "type": "string",
          "enum": [
            "position",
            "area",
            "channel",
            "circle_center"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "datum": {
          "type": "string",
          "minLength": 1
        },
        "datum_source": {
          "type": "string",
          "enum": [
            "explicit",
            "default"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "inferred",
            "unresolved"
          ]
        },
