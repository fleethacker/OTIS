{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parse-command:icd:1.1.0:types",
  "title": "Parse Command ICD 1.1.0 types",
  "$comment": "All references resolve from locally supplied schema resources. Core payloads do not repeat the contract version.",
  "$defs": {
    "security": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "UNCLASSIFIED",
            "CONFIDENTIAL",
            "SECRET",
            "TOP SECRET",
            null
          ]
        },
        "release_to": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "unvalidated",
            "validated",
            "conflict"
          ]
        }
      },
      "required": [
        "policy",
        "classification",
        "release_to",
        "status"
      ],
      "additionalProperties": false
    },
    "contactChannel": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "period": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "start_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "start_time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?:Z)?$"
        },
        "start_label": {
          "type": "string",
          "minLength": 1
        },
        "start_status": {
          "type": "string",
          "enum": [
            "missing_date",
            "missing_date_and_zone",
            "missing_month_and_year",
            "missing_year",
            "missing_day_time_and_year",
            "condition_not_scheduled",
            "not_available_withheld_or_inapplicable",
            "open_ended",
            "unresolved"
          ]
        },
        "end_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end_time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?:Z)?$"
        },
        "end_label": {
          "type": "string",
          "minLength": 1
        },
        "end_status": {
          "type": "string",
          "enum": [
            "missing_date",
            "missing_date_and_zone",
            "missing_month_and_year",
            "missing_year",
            "missing_day_time_and_year",
            "condition_not_scheduled",
            "not_available_withheld_or_inapplicable",
            "open_ended",
            "unresolved"
          ]
        },
        "qualifier_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "qualifier_time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?:Z)?$"
        },
        "qualifier_label": {
          "type": "string",
          "minLength": 1
        },
        "qualifier_status": {
          "type": "string",
          "enum": [
            "missing_date",
            "missing_date_and_zone",
            "missing_month_and_year",
            "missing_year",
            "missing_day_time_and_year",
            "condition_not_scheduled",
            "not_available_withheld_or_inapplicable",
            "open_ended",
            "unresolved"
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "start_at"
              ]
            },
            {
              "required": [
                "start_time"
              ]
            },
            {
              "required": [
                "start_label"
              ]
            },
            {
              "required": [
                "start_status"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "end_at"
              ]
            },
            {
              "required": [
                "end_time"
              ]
            },
            {
              "required": [
                "end_label"
              ]
            },
            {
              "required": [
                "end_status"
              ]
            }
          ]
        }
      ]
    },
    "frequency": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^f[1-9][0-9]*$"
        },
        "hz": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "upper_hz": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "designator": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "emission": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "unavailable",
            "inferred",
            "validated"
          ]
        }
      },
      "required": [
        "id",
        "hz"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "hz": {
                "type": "null"
              }
            },
            "required": [
              "hz"
            ]
          },
          "then": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          }
        }
      ]
    },
    "activity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^a[1-9][0-9]*$"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "inferred",
            "validated",
            "unresolved"
          ]
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?:Z)?$"
        },
        "time_label": {
          "type": "string",
          "minLength": 1
        },
        "time_status": {
          "type": "string",
          "enum": [
            "missing_date",
            "missing_date_and_zone",
            "missing_month_and_year",
            "missing_year",
            "missing_day_time_and_year",
            "condition_not_scheduled",
            "not_available_withheld_or_inapplicable",
            "open_ended",
            "unresolved"
          ]
        },
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "equipment": {
          "type": "string",
          "minLength": 1
        },
        "material": {
          "type": "string",
          "minLength": 1
        },
        "coordination": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "course": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "report": {
          "type": "string",
          "minLength": 1
        },
        "responsible_party": {
          "type": "string",
          "minLength": 1
        },
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "circuits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delivery": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "start_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "start_time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?:Z)?$"
        },
        "start_label": {
          "type": "string",
          "minLength": 1
        },
        "start_status": {
          "type": "string",
          "enum": [
            "missing_date",
            "missing_date_and_zone",
            "missing_month_and_year",
            "missing_year",
            "missing_day_time_and_year",
            "condition_not_scheduled",
            "not_available_withheld_or_inapplicable",
            "open_ended",
            "unresolved"
          ]
        },
        "end_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end_time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?:Z)?$"
        },
        "end_label": {
          "type": "string",
          "minLength": 1
        },
        "end_status": {
          "type": "string",
          "enum": [
            "missing_date",
            "missing_date_and_zone",
            "missing_month_and_year",
            "missing_year",
            "missing_day_time_and_year",
            "condition_not_scheduled",
            "not_available_withheld_or_inapplicable",
            "open_ended",
            "unresolved"
          ]
        },
        "as_of_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "as_of_time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?:Z)?$"
        },
        "as_of_label": {
          "type": "string",
          "minLength": 1
        },
        "as_of_status": {
          "type": "string",
          "enum": [
            "missing_date",
            "missing_date_and_zone",
            "missing_month_and_year",
            "missing_year",
            "missing_day_time_and_year",
            "condition_not_scheduled",
            "not_available_withheld_or_inapplicable",
            "open_ended",
            "unresolved"
          ]
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "deadline_time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?:Z)?$"
        },
        "deadline_label": {
          "type": "string",
          "minLength": 1
        },
        "deadline_status": {
          "type": "string",
          "enum": [
            "missing_date",
            "missing_date_and_zone",
            "missing_month_and_year",
            "missing_year",
            "missing_day_time_and_year",
            "condition_not_scheduled",
            "not_available_withheld_or_inapplicable",
            "open_ended",
            "unresolved"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "tasking"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "task_type",
              "description"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reporting_requirement"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "report",
              "responsible_party"
            ]
          }
        }
      ]
    },
    "contact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^c[1-9][0-9]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contactChannel"
          }
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "position",
        "unit",
        "channels"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "originator": {
          "type": "string",
          "minLength": 1
        },
        "serial": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "issued_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "security": {
          "$ref": "#/$defs/security"
        },
        "command_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "needs_review",
            "partial"
          ]
        },
        "periods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/period"
          }
        },
        "frequencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frequency"
          }
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contact"
          }
        },
        "review_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "subject": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Email subject for display/search; null when absent from the provided source. Raw header and framing evidence belong in audit."
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        }
      },
      "required": [
        "id",
        "revision",
        "type",
        "originator",
        "serial",
        "issued_at",
        "expires_at",
        "security",
        "command_ids",
        "status",
        "periods",
        "frequencies",
        "activities",
        "contacts",
        "subject"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "issued_at": {
                "type": "null"
              }
            },
            "required": [
              "issued_at"
            ]
          },
          "then": {
            "properties": {
              "expires_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "passage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "message_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "originator": {
          "type": "string",
          "minLength": 1
        },
        "issued_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "security": {
          "$ref": "#/$defs/security"
        },
        "command_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "mentioned_units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "embedding_status": {
          "type": "string",
          "enum": [
            "pending",
            "ready",
            "failed"
          ]
        },
        "embedding": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "subject": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Email subject for display/search; null when absent from the provided source. Raw header and framing evidence belong in audit."
        }
      },
      "required": [
        "id",
        "message_id",
        "revision",
        "ordinal",
        "type",
        "originator",
        "issued_at",
        "expires_at",
        "security",
        "command_ids",
        "mentioned_units",
        "text",
        "embedding_status",
        "subject"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "embedding_status": {
                "const": "ready"
              }
            },
            "required": [
              "embedding_status"
            ]
          },
          "then": {
            "required": [
              "embedding"
            ]
          },
          "else": {
            "not": {
              "required": [
                "embedding"
              ]
            }
          }
        }
      ]
    },
    "auditEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "message_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[afcvg][1-9][0-9]*$",
          "description": "Revision-scoped core fact identifier such as a1 or f1; unrelated to the email subject text."
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "review_only": {
          "type": "boolean"
        },
        "security": {
          "$ref": "#/$defs/security"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "message_id",
        "revision",
        "kind",
        "recorded_at",
        "security",
        "payload"
      ],
      "additionalProperties": false
    },
    "geoPoint": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^g[1-9][0-9]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "position",
            "area",
            "channel",
            "circle_center"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "datum": {
          "type": "string",
          "minLength": 1
        },
        "datum_source": {
          "type": "string",
          "enum": [
            "explicit",
            "default"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "inferred",
            "unresolved"
          ]
        },
        "point": {
          "$ref": "#/$defs/geoPoint"
        },
        "shape": {
          "type": "object",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "LineString"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
