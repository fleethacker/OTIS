          "type": "number",
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "datum",
        "datum_source",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "inferred"
              }
            }
          },
          "then": {
            "properties": {
              "datum": {
                "const": "WGS84"
              }
            },
            "oneOf": [
              {
                "required": [
                  "point"
                ],
                "not": {
                  "required": [
                    "shape"
                  ]
                }
              },
              {
                "required": [
                  "shape"
                ],
                "not": {
                  "required": [
                    "point"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unresolved"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "point"
                  ]
                },
                {
                  "required": [
                    "shape"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
