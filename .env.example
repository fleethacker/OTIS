# Optional local overrides. Copy to ignored .env; keep demo ports on loopback.
WATCH_DESK_PORT=8080
OPENSEARCH_PORT=9200
# This must match the exact browser origin, including a changed port.
PARSE_COMMAND_PUBLIC_URL=http://127.0.0.1:8080
# Native local-demo aliases: user/viewer or platform_admin/admin.
ARK_MOCK_AUTH_AS=user
PARSE_COMMAND_REQUIRE_STATION_ASSIGNMENT=false
# Set true only after the documented verified SQLite snapshot import.
PARSE_COMMAND_REQUIRE_STATE_MIGRATION=false
# For OIDC use compose.oidc.yml and a private external secret directory.
# PARSE_COMMAND_SSO_SECRETS=/absolute/private/directory
