{
  "name": "@defense-unicorns/ark-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React UI framework for Ark applications",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "tsconfig.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "harness": "$npm_execpath harness-serve.ts",
    "lint": "oxlint --config .oxlintrc.json .",
    "lint:fix": "oxlint --config .oxlintrc.json . --fix",
    "format": "oxfmt --write \"src/**/*.{ts,tsx,json,css}\" \"harness/**/*.{ts,tsx,json,css}\" \"recipes/**/*.{ts,tsx,json,css}\" harness-serve.ts",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,json,css}\" \"harness/**/*.{ts,tsx,json,css}\" \"recipes/**/*.{ts,tsx,json,css}\" harness-serve.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json",
    "validate": "$npm_execpath run typecheck && $npm_execpath run lint && $npm_execpath run format:check",
    "test": "$npm_execpath test src/ recipes/",
    "test:watch": "$npm_execpath test src/ recipes/ --watch"
  },
  "peerDependencies": {
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "@connectrpc/connect-query": "2.3.1",
    "@tanstack/react-query": "5.103.2",
    "react-icons": "5.7.0",
    "sonner": "2.0.8"
  }
}
