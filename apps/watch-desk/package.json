{
  "name": "generated-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ark-generated application — root workspace (backend + frontend scripts in one place)",
  "workspaces": [
    "ark/ui"
  ],
  "scripts": {
    "dev": "ark run job build --watch",
    "build": "ark run job build",
    "build:ui": "ark run job build",
    "build:go": "ark run job build",
    "vet": "ark run job vet",
    "lint:go": "ark run job lint-go",
    "test": "ark run stage tests",
    "test:go": "ark run job test-go",
    "test:unit": "ark run job test-ui",
    "test:journey": "ark run job journey",
    "typecheck": "ark run job typecheck",
    "lint": "ark run job lint",
    "lint:fix": "ark run job lint --fix",
    "format": "ark run job lint --fix",
    "format:check": "ark run job lint",
    "validate": "ark run stage checks",
    "generate": "ark generate",
    "codegen:routes": "ark run job build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect-web": "2.2.0",
    "@defense-unicorns/ark-ui": "workspace:*",
    "moment-timezone": "0.6.5",
    "react": "19.3.0",
    "react-big-calendar": "1.20.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@connectrpc/protoc-gen-connect-query": "2.3.1",
    "@types/react-big-calendar": "1.16.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
